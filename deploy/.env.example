# Copie para deploy/.env e ajuste. Nunca comitar o arquivo real.

# Hosts públicos
PANEL_HOST=app.me.vr766.com
SHLINK_DEFAULT_DOMAIN=me.vr766.com

# Alvo DNS que os clientes vão apontar (CNAME/A)
PANEL_CUSTOM_DOMAIN_DNS_TARGET=me.vr766.com

# E-mail usado pelo Let's Encrypt (Caddy)
[email protected]

# Banco (MariaDB)
DB_NAME=shlink
DB_USER=shlink
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Chave da API do Shlink (usada pelo painel para falar com o motor)
INITIAL_API_KEY=troque-esta-chave

# Chave da app Laravel — gere com: docker compose run --rm panel php artisan key:generate --show
APP_KEY=

# GeoLite (opcional, para analytics geográficos no Shlink)
GEOLITE_LICENSE_KEY=
