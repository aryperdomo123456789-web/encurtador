# Template for the aaPanel vhost of admin.me.vr766.com.
# Keep the certificate and aaPanel includes generated by the control panel.
server {
    listen 80;
    listen 443 ssl;
    server_name admin.me.vr766.com;

    ssl_certificate /www/server/panel/vhost/cert/admin.me.vr766.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/admin.me.vr766.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $http_x_request_id;
        proxy_read_timeout 60;
        proxy_send_timeout 60;
    }
}
