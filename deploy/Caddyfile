{
	on_demand_tls {
		ask http://panel:8000/tls/allow?domain={host}
	}
}

(proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
}

http:// {
	redir https://{host}{uri} permanent
}

me.vr766.com {
	@panel_paths path / /healthz /health/ready /tls/allow /login* /logout* /links* /domains* /analytics* /billing* /build* /favicon.ico /robots.txt /storage* /up

	handle @panel_paths {
		reverse_proxy panel:8000 {
			import proxy_headers
		}
	}

	handle {
		reverse_proxy shlink:8080 {
			import proxy_headers
		}
	}
}

https:// {
	tls {
		on_demand
	}

	reverse_proxy shlink:8080 {
		import proxy_headers
	}
}
