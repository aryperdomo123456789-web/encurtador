# ops/Caddyfile — Roteamento de borda (produção)
#
# Objetivo: garantir que TODO clique em link curto passe direto pelo motor
# Shlink em Docker, sem tocar no painel PHP/Laravel. O painel só recebe
# tráfego em app.me.vr766.com.
#
# Fluxo:
#   app.me.vr766.com                  -> painel Laravel  (php-fpm)
#   me.vr766.com/{slug}               -> shlink:8080     (redirect 302 rápido)
#   {dominiodocliente.com}/{slug}     -> shlink:8080     (on_demand_tls)
#   qualquer host em app.* que caia   -> painel (mas guard PANEL_HOST filtra)
#
# Requisitos no docker-compose: serviços `panel` (php-fpm+nginx OU laravel
# octane em 127.0.0.1:9000) e `shlink` em 127.0.0.1:8080. Este Caddy
# encapsula ambos e é o único que fala com a Internet.

{
	email ops@vr766.com
	# TLS on-demand: só emite certificado para domínios que passarem no ask.
	on_demand_tls {
		ask http://panel:8000/api/tls/allow
		interval 2m
		burst    5
	}
}

# ┐──────────────────────────────
# 1) PAINEL — único host que roda PHP/Laravel
# ┐──────────────────────────────
app.me.vr766.com {
	encode zstd gzip
	reverse_proxy panel:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host  {host}
		header_up X-Real-IP         {remote_host}
	}
	log {
		output stdout
		format json
	}
}

# ┐──────────────────────────────
# 2) DOMÍNIO PADRÃO — me.vr766.com/{slug} vai direto ao Shlink
#    O painel NUNCA vê essa requisição.
# ┐──────────────────────────────
me.vr766.com, www.me.vr766.com {
	encode zstd gzip

	# Health interno (Caddy responde localmente, sem hop no Shlink)
	respond /__caddy_health 200

	reverse_proxy shlink:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host  {host}
		header_up X-Real-IP         {remote_host}
	}
	log {
		output stdout
		format json
	}
}

# ┐──────────────────────────────
# 3) DOMÍNIOS DE CLIENTES — TLS on-demand + proxy para Shlink
#    Aceita qualquer host que passar em /api/tls/allow.
#    O Shlink resolve o slug pelo header Host.
# ┐──────────────────────────────
:443 {
	tls {
		on_demand
	}

	# Bloqueia acesso ao painel por hostname aleatório —
	# se cair aqui é porque NÃO é app.me.vr766.com nem me.vr766.com.
	@panel host app.me.vr766.com
	handle @panel {
		respond "wrong virtual host" 421
	}

	encode zstd gzip
	reverse_proxy shlink:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host  {host}
		header_up X-Real-IP         {remote_host}

		# Se o Shlink retornar 404 (slug não existe naquele domínio),
		# a resposta passa transparentemente — quem responde é o Shlink,
		# nunca o painel.
	}

	log {
		output stdout
		format json
	}
}

# ┐──────────────────────────────
# 4) HTTP → HTTPS (redirect global; Caddy já faz por padrão,
#    mas explicitamos para clareza)
# ┐──────────────────────────────
:80 {
	redir https://{host}{uri} permanent
}
